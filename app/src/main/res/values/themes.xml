<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LightAlarm" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/sub</item>
    </style>

    <style name="Theme.LightAlarm.Ring" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/ring_bg</item>
        <item name="colorPrimaryDark">@color/ring_bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/ring_bg</item>
        <item name="android:statusBarColor">@color/ring_bg</item>
        <item name="android:navigationBarColor">@color/ring_bg</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
