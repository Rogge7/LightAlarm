<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="现在"
        android:textColor="@color/ring_hint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvRingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="23:30"
        android:textColor="#FFFFFFFF"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="该睡觉了"
        android:textColor="@color/accent"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRingDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="每天"
        android:textColor="@color/ring_hint"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="放下手机吧，明天还要早起"
        android:textColor="@color/ring_sub"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvRingCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/ring_hint"
        android:textSize="13sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_ring_button"
        android:text="延迟 10 分钟"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnAck"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ring_button_primary"
        android:text="知道了，去睡觉"
        android:textAllCaps="false"
        android:textColor="#FF1F2A37"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

</LinearLayout>
